# Terraform working files (regenerated by `terraform init`)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Lambda build artifacts (regenerated by `terraform plan`/`apply`)
infra/builds/
infra/modules/*/builds/

# Local variable overrides that may hold secrets — keep .example files tracked
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local test output
response.json

# Python / editor cruft
__pycache__/
*.pyc
.vscode/
.DS_Store