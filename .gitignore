# Terraform working files (regenerated by `terraform init`)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Lambda build artifacts (regenerated by `terraform plan`/`apply`)
infra/builds/
infra/modules/*/builds/

# Local variable overrides that may hold secrets — keep .example files tracked
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local test output
response.json

# Python / editor cruft
__pycache__/
*.pyc
.vscode/
.DS_Store
*.parquet
/pipeline/load/asn1crypto-1.5.1.dist-info
/pipeline/load/asn1crypto
/pipeline/load/dateutil
/pipeline/load/pg8000-1.31.6.dist-info
/pipeline/load/pg8000
/pipeline/load/python_dateutil-4.0.0.dist-info
/pipeline/load/scramp-1.5.0.dist-info
/pipeline/load/scramp
/pipeline/load/tzdata-2026.6.dist-info
/pipeline/load/tzdata

# Airflow local dev
.env
logs/
config/
